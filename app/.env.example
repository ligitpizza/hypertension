# Flutter build-time config, passed with --dart-define-from-file=.env (cwd app/).
# Also used by `python tasks.py firebase-config` to generate android/app/src/*/google-services.json.
# NEVER commit app/.env. Copy app/.env.example and fill in the values.
# Values: Firebase console > Project settings > Your apps (Android / Web API key).
FIREBASE_ANDROID_API_KEY=
FIREBASE_WEB_API_KEY=
