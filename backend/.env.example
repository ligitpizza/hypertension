# Copy to backend/.env for local development. Never commit backend/.env.
# In Cloud Run, non-secret values are set as env vars and secrets come from Secret Manager.

# dev | prod  (dev enables CORS for http://localhost:* and the /api/docs page)
APP_ENV=dev
APP_VERSION=0.1.0
FIREBASE_PROJECT_ID=hypertension-dd85f

# Firebase Emulator Suite (local only; remove these in the cloud)
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199
GOOGLE_CLOUD_PROJECT=hypertension-dd85f

# Third-party adapters: fake | real
INTEGRATIONS_MODE=fake

# Push notifications (D-33): false logs pushes locally; true in Cloud Run
FCM_ENABLED=false

# /internal/jobs auth: none (local) | oidc (Cloud Run + Cloud Scheduler)
INTERNAL_JOBS_AUTH=none
JOBS_OIDC_AUDIENCE=
JOBS_SERVICE_ACCOUNT=

# ---- Secrets: added per module (Increments 2-3). Leave blank locally when INTEGRATIONS_MODE=fake ----
# AI Health Agent (FR-14.1): key from Google AI Studio; blank = offline fake replies
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Brevo (D-22): API key from Brevo > SMTP & API; EMAIL_FROM must be a verified sender.
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Harvey
# D-64: Brevo SMS for family emergencies (same EMAIL_API_KEY). Sender: up to 11 letters/digits,
# registered for Malaysia in Brevo (SMS > Sender IDs). Empty = SMS only logged.
SMS_SENDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# D-57 testing aid: patients may book any time (even past) to try Complete / No-show.
# deploy-backend copies this value to Cloud Run. Keep false for real use.
DEV_APPOINTMENT_TIMES=false

# D-66 Module 13. Stripe TEST keys only (sk_test_ / pk_test_, from the Stripe dashboard in
# test mode); live keys are refused. Leave empty to use the simulated card form.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# D-68 courier: lalamove (default) or grab. Missing keys or pharmacy location = simulator.
COURIER=lalamove
# Lalamove API v3 SANDBOX keys (Partner Portal > Sandbox > API Keys): pk_test_ / sk_test_.
# Webhook URL to set in the portal: https://hypertension-dd85f.web.app/api/v1/webhooks/lalamove
LALAMOVE_API_KEY=
LALAMOVE_API_SECRET=
# D-67 GrabExpress SANDBOX (needs a Grab partner project). Empty = simulated courier.
GRAB_CLIENT_ID=
GRAB_CLIENT_SECRET=
# Token key you give Grab for the tracking webhook (/api/v1/webhooks/grab).
GRAB_WEBHOOK_SECRET=
# Pickup point sent to the courier: the pharmacy's address, coordinates and phone.
PHARMACY_ADDRESS=
PHARMACY_LAT=
PHARMACY_LNG=
PHARMACY_PHONE=
# Testing aid: patients may start next month's order now. Keep false for real use.
DEV_ORDER_TOOLS=false
