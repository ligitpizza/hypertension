rules_version = '2';

// CareFlow Firestore Security Rules (NFR-2.2, docs/04 "Security Rules summary").
//
// Deny by default. Each module opens only the access paths it needs, with
// emulator rules tests per role (firebase/tests).
//
// The `role` custom claim (request.auth.token.role) is the source of truth.
// Server-only collections are written by FastAPI through the Admin SDK, which
// bypasses these rules: audit_logs, risk_scores, payment_transactions,
// delivery_tracking_events, emergency_alerts, symptom_catalog, health_profiles,
// clinical_alerts (D-32) and users/{uid}/fcmTokens (D-33).
// medication_orders and medication_stock (D-66) are read-only to clients.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----
    function signedIn() { return request.auth != null; }
    function hasRole(r) { return signedIn() && request.auth.token.role == r; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return hasRole('admin'); }

    // Doctor may access a patient's data only when assigned (FR-8.1, NFR-2.2).
    function isAssignedDoctorOf(patientId) {
      return hasRole('doctor')
        && get(/databases/$(database)/documents/users/$(patientId)).data.assignedDoctorId
           == request.auth.uid;
    }

    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ---- users (Module 1, Table 4.2.3.1) ----
    // Created only by FastAPI (register-profile / admin staff) so role and
    // onboarding flags can't be forged.
    match /users/{uid} {
      allow read: if isSelf(uid)
        || isAdmin()
        || (hasRole('doctor') && resource.data.assignedDoctorId == request.auth.uid)
        // D-54: doctors see colleagues (to suggest one when asking for a reassignment).
        || (hasRole('doctor') && resource.data.role == 'doctor')
        // D-42: a patient reads their own assigned doctor (name + public key for messaging).
        || (hasRole('patient')
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedDoctorId == uid)
        // FR-14.2: a family member reads the patient they follow; a patient reads the
        // family members linked to them (D-62).
        || isLinkedFamilyOf(uid)
        || (hasRole('patient') && resource.data.role == 'family_member'
            && resource.data.patientId == request.auth.uid);

      allow create, delete: if false;

      // Self: name, and the E2E public key (D-07, D-42); contact/profile editing grows with
      // Module 12. Admin: account status and doctor assignment (FR-11.1, FR-11.2).
      allow update: if (isSelf(uid) && onlyChanges(['name', 'publicKey', 'updatedAt'])
                        && (!('publicKey' in request.resource.data)
                            || request.resource.data.publicKey is string))
        || (isAdmin() && onlyChanges(['isActive', 'assignedDoctorId', 'updatedAt']));
    }

    // ---- health_profiles (Module 1, Table 4.2.3.2) ----
    // Document ID = patient UID. Written only by FastAPI (onboarding, UC12.2 re-score).
    match /health_profiles/{patientId} {
      allow read: if isSelf(resource.data.patientId)
        || isAdmin()
        || isAssignedDoctorOf(resource.data.patientId);
      allow write: if false;
    }

    // ---- patient-owned health data (Module 2 dashboard reads) ----
    // Family member linked to this patient (users/{family}.patientId, FR-14.2).
    function isLinkedFamilyOf(patientId) {
      return hasRole('family_member')
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.patientId
           == patientId;
    }

    function canReadPatientData(patientId) {
      return isSelf(patientId) || isAdmin() || isAssignedDoctorOf(patientId);
    }

    // vital_readings, risk_scores: also readable by linked family (docs/04).
    // Writes go through FastAPI (logging a reading triggers risk scoring, FR-9.2).
    match /vital_readings/{readingId} {
      allow read: if canReadPatientData(resource.data.patientId)
        || isLinkedFamilyOf(resource.data.patientId);
      allow write: if false;
    }

    match /risk_scores/{scoreId} {
      allow read: if canReadPatientData(resource.data.patientId)
        || isLinkedFamilyOf(resource.data.patientId);
      allow write: if false;
    }

    // ---- Module 5 medications (FR-5.1-5.4; D-43) ----
    // Written only through FastAPI (/medications): duplicate and interaction checks,
    // stock, adherence and audit happen server-side.
    match /medications/{medicationId} {
      allow read: if canReadPatientData(resource.data.patientId);
      allow write: if false;
    }

    // dose_logs carry no patientId (docs/04 Table 4.2.3.7): access follows the parent
    // medication. Clients query with medicationId == X so the rule can be evaluated.
    match /dose_logs/{logId} {
      allow read: if canReadPatientData(
        get(/databases/$(database)/documents/medications/$(resource.data.medicationId)).data.patientId);
      allow write: if false;
    }

    // ---- Module 6 health records (FR-6.1, FR-6.2; D-58) ----
    // Written only through FastAPI. The patient reads their own; the assigned doctor reads
    // a record only while it is shared (queries must filter sharedWithDoctor == true).
    match /health_records/{recordId} {
      allow read: if isSelf(resource.data.patientId)
        || (resource.data.sharedWithDoctor == true
            && isAssignedDoctorOf(resource.data.patientId));
      allow write: if false;
    }

    // appointments: read-only until Module 7 adds its write paths.

    match /appointments/{appointmentId} {
      allow read: if canReadPatientData(resource.data.patientId)
        || (hasRole('doctor') && resource.data.doctorId == request.auth.uid);
      allow write: if false;
    }

    // ---- D-54 doctor assignment requests (UC7.3) ----
    // Written only through FastAPI. The admin sees all; the patient sees requests about
    // them (to show "waiting for the clinic"); a requesting doctor sees their own.
    match /doctor_assignment_requests/{requestId} {
      allow read: if isAdmin()
        || isSelf(resource.data.patientId)
        || isSelf(resource.data.requestedBy);
      allow write: if false;
    }

    // ---- Module 8 doctor-authored records (FR-8.2, FR-8.3; docs/04 rules summary) ----
    // Written only through FastAPI (assignment check + audit). Read by the patient,
    // their assigned doctor and admin; pharmacists also read prescriptions (Module 13).
    match /clinical_notes/{noteId} {
      allow read: if canReadPatientData(resource.data.patientId);
      allow write: if false;
    }

    match /care_plans/{patientId} {
      allow read: if canReadPatientData(resource.data.patientId);
      allow write: if false;

      // D-41: every saved version of the plan (document id of the parent = patient uid).
      match /versions/{versionId} {
        allow read: if canReadPatientData(patientId);
        allow write: if false;
      }
    }

    match /prescriptions/{prescriptionId} {
      allow read: if canReadPatientData(resource.data.patientId) || hasRole('pharmacist');
      allow write: if false;
    }

    // ---- Module 13 orders and pharmacy stock (FR-13.x, D-66) ----
    // Every write goes through FastAPI (payment, courier and stock rules). The app reads
    // orders through the API too; these reads are for the owner and pharmacy staff.
    match /medication_orders/{orderId} {
      allow read: if isSelf(resource.data.patientId) || hasRole('pharmacist') || isAdmin();
      allow write: if false;
    }

    match /medication_stock/{stockId} {
      allow read: if hasRole('pharmacist') || isAdmin();
      allow write: if false;
    }

    // ---- D-69: medication catalogue and pharmacy chat ----
    // Catalogue: read by prescribing / dispensing staff; prices change through FastAPI.
    match /medication_catalog/{itemId} {
      allow read: if hasRole('doctor') || hasRole('pharmacist') || isAdmin();
      allow write: if false;
    }

    // One pharmacy conversation per patient, shared by all pharmacists. Written only
    // through FastAPI (pushes, audit); not end-to-end encrypted (D-69 deviation).
    match /pharmacy_messages/{messageId} {
      allow read: if isSelf(resource.data.patientId) || hasRole('pharmacist');
      allow write: if false;
    }

    // ---- agent_messages (FR-14.1, Table 4.2.3.16) ----
    // Written only by FastAPI (it calls Gemini). Read by the patient for the chat screen,
    // and by the assigned doctor / admin like other patient-owned data (docs/04).
    match /agent_messages/{messageId} {
      allow read: if canReadPatientData(resource.data.patientId);
      allow write: if false;
    }

    // ---- triage_outcomes (FR-14.3, Table 4.2.3.5) ----
    // Written by FastAPI (rule table + doctor notification); patient, assigned doctor, admin read.
    match /triage_outcomes/{outcomeId} {
      allow read: if canReadPatientData(resource.data.patientId);
      allow write: if false;
    }

    // ---- messages (Module 10, Table 4.2.3.13; NFR-2.1, D-09, D-42) ----
    // End-to-end encrypted: written by the sender's client, never readable by the server
    // logic. Only between a patient and their assigned doctor (FR-10.1).
    function messageAllowedTo(recipientId) {
      return (hasRole('patient')
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedDoctorId
             == recipientId)
        || (hasRole('doctor')
          && get(/databases/$(database)/documents/users/$(recipientId)).data.assignedDoctorId
             == request.auth.uid);
    }

    // D-52: an attachment must live in the sender->recipient folder under this message's id.
    function validAttachment(d, messageId) {
      return !('attachmentPath' in d)
        || (d.attachmentPath == 'message_attachments/' + d.senderId + '/' + d.recipientId
                                 + '/' + messageId
            && d.attachmentType in ['image', 'pdf']
            && d.attachmentSize is int && d.attachmentSize > 0
            && d.attachmentSize <= 10485760
            && d.attachmentName is string && d.attachmentName.size() < 2000);
    }

    match /messages/{messageId} {
      allow read: if signedIn()
        && (resource.data.senderId == request.auth.uid
            || resource.data.recipientId == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['senderId', 'recipientId', 'encryptedText',
             'isFlagged', 'sentAt', 'senderPublicKey', 'recipientPublicKey',
             'attachmentPath', 'attachmentType', 'attachmentSize', 'attachmentName'])
        && validAttachment(request.resource.data, messageId)
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.encryptedText is string
        && request.resource.data.encryptedText.size() < 20000
        && request.resource.data.isFlagged is bool
        && request.resource.data.senderPublicKey is string
        && request.resource.data.recipientPublicKey is string
        && request.resource.data.sentAt == request.time
        && messageAllowedTo(request.resource.data.recipientId);

      // UC10.3 E1: the doctor who received a flagged message may clear the flag.
      allow update: if hasRole('doctor')
        && resource.data.recipientId == request.auth.uid
        && onlyChanges(['isFlagged'])
        && request.resource.data.isFlagged == false;

      allow delete: if false;
    }

    // ---- symptom_catalog: static lookup, read by any signed-in user ----
    match /symptom_catalog/{symptomId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ---- clinical_alerts (D-32): doctor-facing alerts from Module 9 ----
    // Created by FastAPI only. The addressed doctor reads them (alerts panel, FR-8.4)
    // and may acknowledge or dismiss an open alert; admin reads for oversight.
    match /clinical_alerts/{alertId} {
      allow read: if isAdmin()
        || (hasRole('doctor') && resource.data.doctorId == request.auth.uid);
      allow update: if hasRole('doctor')
        && resource.data.doctorId == request.auth.uid
        && resource.data.status == 'open'
        && onlyChanges(['status', 'acknowledgedAt'])
        && request.resource.data.status in ['acknowledged', 'dismissed']
        && request.resource.data.acknowledgedAt == request.time;
      allow create, delete: if false;
    }

    // ---- users/{uid}/fcmTokens (D-33): registered through FastAPI, server-only ----
    match /users/{uid}/fcmTokens/{token} {
      allow read, write: if false;
    }

    // ---- FR-14.2 family monitoring (D-06, D-62) ----
    // Written only through FastAPI. Each side reads its own requests and alerts.
    match /family_link_requests/{requestId} {
      allow read: if request.auth != null
        && (resource.data.familyMemberId == request.auth.uid
            || resource.data.patientId == request.auth.uid);
      allow write: if false;
    }

    match /emergency_alerts/{alertId} {
      allow read: if request.auth != null
        && (resource.data.familyMemberId == request.auth.uid
            || resource.data.patientId == request.auth.uid);
      allow write: if false;
    }

    // ---- audit_logs: server-only writes (FR-1.5); admin viewer in Module 11 ----
    match /audit_logs/{logId} {
      allow read, write: if false;
    }

    // Everything else is closed until its module defines access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
