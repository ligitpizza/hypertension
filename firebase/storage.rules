rules_version = '2';

// CareFlow Cloud Storage rules. Increment 0 baseline: deny all.
// Health record uploads (PDF/JPG/PNG, <= 10 MB, owner + shared doctor read)
// are added with Module 6 (Increment 3).
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
