rules_version = '2';

// CareFlow Cloud Storage rules. Deny by default.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // D-58 health records: the patient uploads once to their own folder (PDF/JPG/PNG,
    // <= 10 MB), reads it and may delete it. The doctor opens shared files through FastAPI.
    match /health_records/{patientId}/{recordId} {
      allow create: if request.auth != null
        && request.auth.uid == patientId
        && request.auth.token.role == 'patient'
        && resource == null
        && request.resource.size <= 10485760
        && request.resource.contentType in ['application/pdf', 'image/jpeg', 'image/png'];
      allow read, delete: if request.auth != null && request.auth.uid == patientId;
      allow update: if false;
    }

    // D-52 message attachments: end-to-end encrypted on the device, so Storage only ever
    // holds opaque bytes. Only the sender uploads (once); only the two people read.
    // 10 MB file + AES-GCM nonce and tag.
    match /message_attachments/{senderId}/{recipientId}/{fileId} {
      allow create: if request.auth != null
        && resource == null  // never replace a file once sent
        && request.auth.uid == senderId
        && senderId != recipientId
        && request.resource.size <= 10485760 + 64
        && request.resource.contentType == 'application/octet-stream';
      allow read: if request.auth != null
        && (request.auth.uid == senderId || request.auth.uid == recipientId);
      allow update, delete: if false;
    }
  }
}
