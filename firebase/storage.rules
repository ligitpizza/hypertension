rules_version = '2';

// CareFlow Cloud Storage rules. Deny by default.
// Health record uploads (PDF/JPG/PNG, <= 10 MB, owner + shared doctor read)
// are added with Module 6 (Increment 3).
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // D-52 message attachments: end-to-end encrypted on the device, so Storage only ever
    // holds opaque bytes. Only the sender uploads (once); only the two people read.
    // 10 MB file + AES-GCM nonce and tag.
    match /message_attachments/{senderId}/{recipientId}/{fileId} {
      allow create: if request.auth != null
        && resource == null  // never replace a file once sent
        && request.auth.uid == senderId
        && senderId != recipientId
        && request.resource.size <= 10485760 + 64
        && request.resource.contentType == 'application/octet-stream';
      allow read: if request.auth != null
        && (request.auth.uid == senderId || request.auth.uid == recipientId);
      allow update, delete: if false;
    }
  }
}
